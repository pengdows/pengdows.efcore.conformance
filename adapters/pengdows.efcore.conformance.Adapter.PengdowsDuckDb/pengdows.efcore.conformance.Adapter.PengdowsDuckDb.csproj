<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>pengdows.efcore.conformance.Adapter.PengdowsDuckDb</AssemblyName>
    <RootNamespace>pengdows.efcore.conformance.Adapter.PengdowsDuckDb</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native libduckdb only: the managed driver comes from the adonet DuckDB project (Giorgi's develop build). -->
    <PackageReference Include="DuckDB.NET.Bindings.Full" ExcludeAssets="compile" />
    <ProjectReference Include="../../src/pengdows.efcore.conformance.Contracts/pengdows.efcore.conformance.Contracts.csproj" />
    <ProjectReference Include="../../../pengdows.efcore.adonet/src/pengdows.efcore.adonet.duckdb/pengdows.efcore.adonet.duckdb.csproj" />
  </ItemGroup>
</Project>
